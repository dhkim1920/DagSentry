# Image and listener settings used by Docker Compose interpolation.
DAGSENTRY_IMAGE=dagsentry:production
DAGSENTRY_BIND_ADDRESS=127.0.0.1
DAGSENTRY_HTTP_PORT=8000
DAGSENTRY_POSTGRES_DB=dagsentry
DAGSENTRY_POSTGRES_USER=dagsentry

# Secret file paths. The files themselves must not be committed.
DAGSENTRY_POSTGRES_PASSWORD_FILE=deployment/secrets/postgres_password
DAGSENTRY_DATABASE_URL_FILE=deployment/secrets/database_url
DAGSENTRY_MIGRATION_DATABASE_URL_FILE=deployment/secrets/migration_database_url
DAGSENTRY_INGEST_API_TOKEN_FILE=deployment/secrets/ingest_api_token
DAGSENTRY_CONNECTION_ENCRYPTION_KEY_FILE=deployment/secrets/connection_encryption_key

# DagSentry non-secret runtime settings.
DAGSENTRY_ENVIRONMENT=production
DAGSENTRY_SESSION_TTL_HOURS=12
DAGSENTRY_CONNECTION_ENCRYPTION_KEY_VERSION=1
DAGSENTRY_AIRFLOW_CONFIG_SOURCE=database
DAGSENTRY_LLM_CONFIG_SOURCE=environment
DAGSENTRY_NOTIFICATION_CONFIG_SOURCE=database
DAGSENTRY_LLM_PROMPT_VERSION=ai-diagnosis-ko-v1
DAGSENTRY_DISPLAY_TIMEZONE=Asia/Seoul
DAGSENTRY_REPORT_TIMEZONE=Asia/Seoul
DAGSENTRY_DAILY_REPORT_PROMPT_VERSION=daily-report-ko-v1
DAGSENTRY_LOG_LEVEL=INFO

# Worker bounds.
DAGSENTRY_WORKER_MAX_ATTEMPTS=5
DAGSENTRY_WORKER_BACKOFF_BASE_SECONDS=5
DAGSENTRY_WORKER_BACKOFF_MAX_SECONDS=300
DAGSENTRY_WORKER_POLL_INTERVAL_SECONDS=1
DAGSENTRY_WORKER_STALE_LOCK_TIMEOUT_SECONDS=900

# Daily Report scheduler bounds.
DAGSENTRY_SCHEDULER_POLL_INTERVAL_SECONDS=5
DAGSENTRY_SCHEDULER_HEARTBEAT_INTERVAL_SECONDS=10
DAGSENTRY_SCHEDULER_OFFLINE_AFTER_SECONDS=30
