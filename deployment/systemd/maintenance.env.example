# Install as /etc/dagsentry/maintenance.env, readable only by the service identity/root.
# The role needs SELECT/DELETE on user_sessions and worker_heartbeats, plus
# UPDATE(id) on user_sessions and UPDATE(instance_id) on worker_heartbeats for row locks.
# Use the same Worker offline threshold as the API.
DAGSENTRY_DATABASE_URL=postgresql+psycopg:///?service=dagsentry-maintenance
DAGSENTRY_WORKER_OFFLINE_AFTER_SECONDS=30
DAGSENTRY_RETENTION_DAYS=30

# libpq files must be readable by dagsentry; password files must have mode 0600.
# The backup role needs SELECT on all application tables and sequences.
PGSERVICEFILE=/etc/dagsentry/pg_service.conf
PGPASSFILE=/etc/dagsentry/pgpass
DAGSENTRY_BACKUP_SERVICE=dagsentry-backup
DAGSENTRY_CONNECTION_ENCRYPTION_KEY_VERSION=1
# Replace with the deployed application commit before enabling the backup timer.
DAGSENTRY_GIT_REVISION=REPLACE_WITH_DEPLOYED_COMMIT
