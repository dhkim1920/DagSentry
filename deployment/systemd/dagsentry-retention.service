[Unit]
Description=DagSentry operational record retention
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=dagsentry
Group=dagsentry
WorkingDirectory=/opt/dagsentry
EnvironmentFile=/etc/dagsentry/maintenance.env
ExecStart=/opt/dagsentry/.venv/bin/dagsentry-retention --days ${DAGSENTRY_RETENTION_DAYS} --batch-size 1000 --apply
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
TimeoutStartSec=15m
