# Local example PostgreSQL settings. Replace before any shared or production use.
DAGSENTRY_POSTGRES_DB=example_dagsentry
DAGSENTRY_POSTGRES_USER=example_user
DAGSENTRY_POSTGRES_PASSWORD=example_password
DAGSENTRY_POSTGRES_BIND_ADDRESS=127.0.0.1
DAGSENTRY_POSTGRES_PORT=5432
DAGSENTRY_DATABASE_URL=postgresql+psycopg://example_user:example_password@127.0.0.1:5432/example_dagsentry
DAGSENTRY_INGEST_API_TOKEN=replace-with-a-long-random-value
DAGSENTRY_VIEWER_API_TOKEN=replace-with-a-read-only-random-value
DAGSENTRY_OPERATOR_API_TOKEN=replace-with-a-separate-long-random-value
DAGSENTRY_OPERATOR_API_IDENTITY=oncall@example.com
DAGSENTRY_SESSION_TTL_HOURS=12
# Failed login attempts allowed from one client IP in the window below.
DAGSENTRY_LOGIN_RATE_LIMIT_ATTEMPTS=10
DAGSENTRY_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
# Base64 of exactly 32 random bytes, for example: openssl rand -base64 32
# DAGSENTRY_CONNECTION_ENCRYPTION_KEY=replace-with-generated-base64-key
DAGSENTRY_CONNECTION_ENCRYPTION_KEY_VERSION=1
# environment (default) reads the values below; database reads the enabled Managed Connection.
DAGSENTRY_AIRFLOW_CONFIG_SOURCE=environment
DAGSENTRY_AIRFLOW_API_BASE_URL=http://airflow-api-server:8080
DAGSENTRY_AIRFLOW_API_TOKEN=replace-with-an-airflow-bearer-token
DAGSENTRY_AIRFLOW_API_TIMEOUT_SECONDS=5
DAGSENTRY_AIRFLOW_API_MAX_ATTEMPTS=2
DAGSENTRY_AIRFLOW_API_RETRY_BACKOFF_SECONDS=0.1
DAGSENTRY_AIRFLOW_LOG_MAX_RESPONSE_BYTES=1048576
DAGSENTRY_AIRFLOW_UI_BASE_URL=http://airflow-api-server:8080

# Optional AI Diagnosis. Leave DAGSENTRY_LLM_PROVIDER unset to use Rule fallback only.
# environment (default) reads Provider values below; database currently supports Ollama.
# DAGSENTRY_LLM_CONFIG_SOURCE=environment
# DAGSENTRY_LLM_PROVIDER=openai
# DAGSENTRY_LLM_MODEL=gpt-5.6-luna
# DAGSENTRY_LLM_PROMPT_VERSION=ai-diagnosis-ko-v1
# DAGSENTRY_NOTIFICATION_FALLBACK_PROVIDERS=["smtp"]
# DAGSENTRY_DISPLAY_TIMEZONE=Asia/Seoul
# DAGSENTRY_DAILY_REPORT_PROMPT_VERSION=daily-report-ko-v1
# DAGSENTRY_OPENAI_API_KEY=replace-with-an-openai-api-key
# DAGSENTRY_OPENAI_API_BASE_URL=https://api.openai.com/v1
# HTTP is allowed only for localhost. For a deliberately trusted private endpoint,
# set this JSON array to its exact hostname or IP, for example: ["10.0.0.15"].
# DAGSENTRY_INSECURE_HTTP_TRUSTED_HOSTS=[]
# DAGSENTRY_LLM_TIMEOUT_SECONDS=15
# DAGSENTRY_LLM_MAX_ATTEMPTS=2
# DAGSENTRY_LLM_RETRY_BACKOFF_SECONDS=0.5

# Azure OpenAI alternative. DAGSENTRY_LLM_MODEL is the Azure deployment name.
# DAGSENTRY_LLM_PROVIDER=azure_openai
# DAGSENTRY_LLM_MODEL=orders-diagnosis-deployment
# DAGSENTRY_AZURE_OPENAI_ENDPOINT=https://resource-name.openai.azure.com
# DAGSENTRY_AZURE_OPENAI_API_KEY=replace-with-an-azure-openai-api-key

# Anthropic alternative using the Messages API and native structured outputs.
# DAGSENTRY_LLM_PROVIDER=anthropic
# DAGSENTRY_LLM_MODEL=claude-sonnet-4-6
# DAGSENTRY_ANTHROPIC_API_KEY=replace-with-an-anthropic-api-key
# DAGSENTRY_ANTHROPIC_API_BASE_URL=https://api.anthropic.com/v1
# DAGSENTRY_ANTHROPIC_MAX_OUTPUT_TOKENS=2048

# AWS Bedrock alternative using Converse and the standard AWS credential chain.
# DAGSENTRY_LLM_PROVIDER=bedrock
# DAGSENTRY_LLM_MODEL=anthropic.claude-sonnet-4-6-v1:0
# DAGSENTRY_BEDROCK_REGION=ap-northeast-2
# DAGSENTRY_BEDROCK_MAX_OUTPUT_TOKENS=2048

# Local or self-hosted Ollama alternative. The API has no built-in local authentication.
# DAGSENTRY_LLM_PROVIDER=ollama
# DAGSENTRY_LLM_MODEL=gemma3
# DAGSENTRY_OLLAMA_API_BASE_URL=http://localhost:11434/api
# DAGSENTRY_OLLAMA_MAX_OUTPUT_TOKENS=2048

# Notification Provider used by the Diagnosis Worker, Recovery Checker, and Daily Report
# environment (default) reads the values below; database currently supports Slack.
DAGSENTRY_NOTIFICATION_CONFIG_SOURCE=environment
DAGSENTRY_NOTIFICATION_PROVIDER=webhook
DAGSENTRY_WEBHOOK_URL=https://example.invalid/dagsentry
# DAGSENTRY_WEBHOOK_BEARER_TOKEN=replace-with-a-webhook-token
DAGSENTRY_WEBHOOK_TIMEOUT_SECONDS=5
DAGSENTRY_WEBHOOK_MAX_ATTEMPTS=2
DAGSENTRY_WEBHOOK_RETRY_BACKOFF_SECONDS=0.5

# Slack alternative. Set DAGSENTRY_NOTIFICATION_PROVIDER=slack and configure a chat:write bot.
# DAGSENTRY_SLACK_BOT_TOKEN=xoxb-replace-with-a-slack-bot-token
# DAGSENTRY_SLACK_CHANNEL=C0123456789
# DAGSENTRY_SLACK_API_BASE_URL=https://slack.com/api
# DAGSENTRY_SLACK_TIMEOUT_SECONDS=5
# DAGSENTRY_SLACK_MAX_ATTEMPTS=2
# DAGSENTRY_SLACK_RETRY_BACKOFF_SECONDS=0.5

# Microsoft Teams Workflows alternative. The Webhook URL contains a secret signature.
# DAGSENTRY_NOTIFICATION_PROVIDER=teams
# DAGSENTRY_TEAMS_WEBHOOK_URL=https://example.logic.azure.com/workflows/.../triggers/manual/paths/invoke?sig=...
# DAGSENTRY_TEAMS_TIMEOUT_SECONDS=5
# DAGSENTRY_TEAMS_MAX_ATTEMPTS=2
# DAGSENTRY_TEAMS_RETRY_BACKOFF_SECONDS=0.5

# Discord Incoming Webhook alternative. The URL contains a secret token.
# DAGSENTRY_NOTIFICATION_PROVIDER=discord
# DAGSENTRY_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/id/token
# DAGSENTRY_DISCORD_TIMEOUT_SECONDS=5
# DAGSENTRY_DISCORD_MAX_ATTEMPTS=2
# DAGSENTRY_DISCORD_RETRY_BACKOFF_SECONDS=0.5

# Diagnosis Worker
DAGSENTRY_DIAGNOSIS_REUSE_MAX_AGE_DAYS=30
DAGSENTRY_WORKER_MAX_ATTEMPTS=5
DAGSENTRY_WORKER_BACKOFF_BASE_SECONDS=5
DAGSENTRY_WORKER_BACKOFF_MAX_SECONDS=300
DAGSENTRY_WORKER_POLL_INTERVAL_SECONDS=1
DAGSENTRY_WORKER_STALE_LOCK_TIMEOUT_SECONDS=900

# Log sanitization and relevant excerpt
DAGSENTRY_LOG_MAX_INPUT_CHARS=1048576
DAGSENTRY_LOG_EXCERPT_MAX_LINES=80
DAGSENTRY_LOG_EXCERPT_MAX_CHARS=16000
DAGSENTRY_LOG_EXCERPT_CONTEXT_LINES=2
# JSON array of Python regular expressions whose entire matches are masked.
DAGSENTRY_LOG_SECRET_PATTERNS=[]

# Airflow collector processes
DAGSENTRY_ENVIRONMENT=production
DAGSENTRY_INGEST_URL=http://dagsentry:8000/api/v1/failure-events

# Airflow Reconciler DAG
DAGSENTRY_RECONCILER_TIMEOUT_SECONDS=10
DAGSENTRY_RECONCILER_MAX_ATTEMPTS=3
DAGSENTRY_RECONCILER_RETRY_BACKOFF_SECONDS=0.5
DAGSENTRY_RECONCILER_PAGE_SIZE=100
DAGSENTRY_RECONCILER_OVERLAP_SECONDS=300
DAGSENTRY_RECONCILER_INITIAL_LOOKBACK_SECONDS=86400
# DAGSENTRY_RECONCILER_WATERMARK_KEY=dagsentry_reconciler_watermark_production
